# Optional public backend origin. Leave empty to use the Vite same-origin proxy.
VITE_API_BASE_URL=
# Public browser tile configuration; never put server/database credentials here.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
