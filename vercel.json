{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/app/hosted.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/app/hosted.py" },
    { "src": "/health/(.*)", "dest": "backend/app/hosted.py" },
    { "src": "/docs", "dest": "backend/app/hosted.py" },
    { "src": "/openapi.json", "dest": "backend/app/hosted.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}