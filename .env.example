# Local development only. Replace this password in your private .env.
POSTGRES_USER=quakeph
POSTGRES_PASSWORD=quakeph_local_change_me
POSTGRES_DB=quakeph
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://quakeph:quakeph_local_change_me@localhost:55432/quakeph
MIN_LATITUDE=4
MAX_LATITUDE=22
MIN_LONGITUDE=116
MAX_LONGITUDE=130

# Separate worker; seconds between completed attempts (no scheduler inside FastAPI).
WORKER_RECENT_SECONDS=300
WORKER_RECONCILE_SECONDS=86400
WORKER_RECONCILE_DAYS=30
WORKER_RETRY_SECONDS=300
WORKER_HEARTBEAT_SECONDS=10
WORKER_POLL_SECONDS=1
# Maximum stored IDs rechecked per reconciliation pass; remaining IDs stay resumable.
RECHECK_MAX_IDS=100

# JSON array of explicit browser origins; read endpoints allow GET, no credentials.
FRONTEND_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]
API_WORKER_FRESH_SECONDS=30
